import {
  Button, Callout, Card, CardBody, Checkbox, Divider, Grid, H1, H2, Pill, Row,
  Spacer, Stat, Stack, Table, Text, TextInput, useCanvasAction, useCanvasState,
  useEffect, useHostTheme, useRef, useState,
} from "cursor/canvas";

type ActionStatus = "open" | "in_progress" | "done" | "cancelled" | "blocked";
type Draft = { status?: ActionStatus; due?: string; notes?: string };
type TabId = "today" | "initiatives" | "actions" | "stakeholder";
const DATA = /* WORKBOARD_DATA */;
const STATUS: { value: ActionStatus; label: string }[] = [
  { value: "open", label: "Open" }, { value: "in_progress", label: "In progress" },
  { value: "blocked", label: "Blocked" }, { value: "done", label: "Done" },
  { value: "cancelled", label: "Cancelled" },
];

function dateText(value?: string | null) {
  if (!value) return "Set date";
  return new Intl.DateTimeFormat(undefined, { weekday: "short", day: "numeric", month: "short" }).format(new Date(`${value.slice(0, 10)}T12:00:00`));
}
function dueText(value?: string | null, status?: string) {
  if (!value) return "No due date";
  if (status === "done") return "Done";
  if (status === "cancelled") return "Cancelled";
  const days = Math.round((new Date(`${value.slice(0, 10)}T12:00:00`).getTime() - new Date(`${DATA.today}T12:00:00`).getTime()) / 86400000);
  return days < 0 ? `${Math.abs(days)}d overdue` : days === 0 ? "Due today" : days === 1 ? "Due tomorrow" : days <= 7 ? `Due in ${days} days` : `Due ${dateText(value)}`;
}
function isUrgent(value?: string | null, status?: string) {
  return Boolean(value && status !== "done" && status !== "cancelled" && new Date(`${value.slice(0, 10)}T12:00:00`).getTime() - new Date(`${DATA.today}T12:00:00`).getTime() <= 86400000);
}
const PRIORITY_ORDER: Record<string, number> = { high: 0, medium: 1, low: 2 };
function sortOpenActions(list: any[]) {
  return [...list].sort((a, b) => {
    const dueA = a.due ? new Date(`${String(a.due).slice(0, 10)}T12:00:00`).getTime() : Number.MAX_SAFE_INTEGER;
    const dueB = b.due ? new Date(`${String(b.due).slice(0, 10)}T12:00:00`).getTime() : Number.MAX_SAFE_INTEGER;
    if (dueA !== dueB) return dueA - dueB;
    const priA = PRIORITY_ORDER[String(a.priority)] ?? 9;
    const priB = PRIORITY_ORDER[String(b.priority)] ?? 9;
    if (priA !== priB) return priA - priB;
    return String(a.task ?? "").localeCompare(String(b.task ?? ""));
  });
}
function draftDelta(action: any, draft: Draft): Draft {
  const delta: Draft = {};
  if (draft.status !== undefined && draft.status !== action.status) delta.status = draft.status;
  if (draft.due !== undefined && draft.due !== (action.due ?? "")) delta.due = draft.due;
  if (draft.notes !== undefined && draft.notes !== (action.notes ?? "")) delta.notes = draft.notes;
  return delta;
}
function pruneDrafts(drafts: Record<string, Draft>, actions: any[]): Record<string, Draft> {
  const byId = new Map(actions.map((action) => [action.id, action]));
  const next: Record<string, Draft> = {};
  for (const [id, draft] of Object.entries(drafts)) {
    const action = byId.get(id);
    if (!action) continue;
    const delta = draftDelta(action, draft);
    if (Object.keys(delta).length) next[id] = delta;
  }
  return next;
}
function countDraftChanges(drafts: Record<string, Draft>, actions: any[]): number {
  return Object.keys(pruneDrafts(drafts, actions)).length;
}
function StatusPicker({ value, onChange }: { value: ActionStatus; onChange: (value: ActionStatus) => void }) {
  const theme = useHostTheme(); const [open, setOpen] = useState(false); const [menuStyle, setMenuStyle] = useState<{ top: number; left: number; minWidth: number } | null>(null); const ref = useRef<HTMLDivElement | null>(null);
  const toggle = () => {
    if (open) { setOpen(false); return; }
    const rect = ref.current?.getBoundingClientRect();
    if (!rect) return;
    setMenuStyle({ top: rect.bottom + 4, left: rect.left, minWidth: Math.max(rect.width, 160) });
    setOpen(true);
  };
  useEffect(() => { if (!open) return; const close = (event: MouseEvent) => { if (ref.current && event.target instanceof Node && !ref.current.contains(event.target)) setOpen(false); }; document.addEventListener("mousedown", close); return () => document.removeEventListener("mousedown", close); }, [open]);
  const label = STATUS.find((item) => item.value === value)?.label ?? value;
  return <div ref={ref} style={{ position: "relative", display: "inline-block", zIndex: open ? 50 : "auto" }}><Button variant="secondary" onClick={toggle}>{label} ▾</Button>{open && menuStyle ? <div style={{ position: "fixed", top: menuStyle.top, left: menuStyle.left, zIndex: 1000, minWidth: menuStyle.minWidth, padding: 6, border: `1px solid ${theme.stroke.primary}`, borderRadius: 6, background: theme.bg.elevated }}><Stack gap={4}>{STATUS.map((item) => <div key={item.value}><Button variant={item.value === value ? "primary" : "secondary"} onClick={() => { onChange(item.value); setOpen(false); }}>{item.label}</Button></div>)}</Stack></div> : null}</div>;
}
function DatePicker({ value, onChange }: { value: string; onChange: (value: string) => void }) {
  const theme = useHostTheme(); const ref = useRef<HTMLInputElement | null>(null); const [hover, setHover] = useState(false);
  const open = () => { const input = ref.current; if (!input) return; input.focus(); if (typeof input.showPicker === "function") input.showPicker(); };
  return <div onClick={open} onMouseEnter={() => setHover(true)} onMouseLeave={() => setHover(false)} style={{ position: "relative", display: "inline-flex", alignItems: "center", height: 28, padding: "0 10px", cursor: "pointer", borderRadius: 4, border: `1px solid ${hover ? theme.stroke.primary : theme.stroke.secondary}`, background: hover ? theme.fill.secondary : theme.fill.tertiary }}><Text size="small">{dateText(value)}</Text><input ref={ref} type="date" value={value} tabIndex={-1} onChange={(event: { target: { value: string } }) => onChange(event.target.value)} style={{ position: "absolute", inset: 0, width: "100%", height: "100%", opacity: 0, pointerEvents: "none" }} /></div>;
}
function StatusDot({ status }: { status: string }) {
  const theme = useHostTheme();
  const color = status === "critical" ? theme.category.red : status === "at-risk" ? theme.category.orange : status === "on-track" || status === "monitoring" ? theme.category.green : status === "closed" ? theme.text.tertiary : theme.accent.primary;
  const labels: Record<string, string> = { new: "New", "on-track": "On track", "at-risk": "At risk", critical: "Critical", monitoring: "Monitoring", closed: "Closed" };
  return <Row align="center" gap={6}><span style={{ width: 8, height: 8, borderRadius: 8, background: color, flexShrink: 0 }} /><Text size="small" weight="semibold" style={{ color }}>{labels[status] ?? status}</Text></Row>;
}
function PriorityRow({ item, index, checked, onChange }: { item: any; index: number; checked: boolean; onChange: (checked: boolean) => void }) {
  const theme = useHostTheme(); const color = item.kind === "refresh" ? theme.accent.primary : String(item.reason).includes("overdue") ? theme.category.red : theme.category.orange;
  return <div style={{ display: "grid", gridTemplateColumns: "28px 1fr auto", gap: 10, alignItems: "start", padding: "12px", borderBottom: `1px solid ${theme.stroke.tertiary}`, borderLeft: `3px solid ${color}`, opacity: checked ? 0.55 : 1 }}><Text size="small" weight="semibold" style={{ color }}>{index + 1}</Text><Stack gap={3}><Text weight="semibold" style={{ textDecoration: checked ? "line-through" : "none" }}>{item.title}</Text><Row gap={8} wrap>{item.initiative ? <Text size="small" tone="tertiary">{item.initiative}</Text> : null}<Text size="small" weight="semibold" style={{ color }}>{item.reason}</Text></Row><Text size="small" tone="secondary">{item.instruction}</Text></Stack><Checkbox checked={checked} label="Done" onChange={onChange} /></div>;
}
function CalendarBlock({ block, start, pixelsPerMinute }: { block: any; start: number; pixelsPerMinute: number }) {
  const theme = useHostTheme();
  const minutes = block.end - block.start;
  const compact = minutes < 30;
  const tone = block.cancelled ? theme.text.tertiary : block.focus ? theme.category.green : block.highlight ? theme.category.orange : theme.accent.primary;
  return <div style={{ position: "absolute", top: `${(block.start - start) * pixelsPerMinute}px`, height: `${minutes * pixelsPerMinute}px`, left: `${(block.lane / block.laneCount) * 100 + 1}%`, width: `${100 / block.laneCount - 2}%`, display: "flex", flexDirection: compact ? "row" : "column", alignItems: compact ? "center" : "flex-start", justifyContent: "flex-start", gap: compact ? 6 : 2, padding: compact ? "1px 6px" : "6px 8px", overflow: "hidden", background: block.cancelled ? theme.fill.tertiary : theme.fill.secondary, borderLeft: `3px solid ${tone}`, borderRadius: 4, textDecoration: block.cancelled ? "line-through" : "none", opacity: block.cancelled ? 0.55 : 1 }}>{compact ? <Text size="small" weight="semibold" style={{ overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap", fontSize: 11, lineHeight: "13px" }}>{block.title} · {block.startLabel} to {block.endLabel}</Text> : <><Text size="small" weight="semibold">{block.title}</Text><Text size="small" tone="tertiary">{block.startLabel} to {block.endLabel}{block.organizer ? ` · ${block.organizer}` : ""}</Text></>}</div>;
}
function CalendarTimeline() {
  const theme = useHostTheme(); const start = 600; const pixelsPerMinute = 1.6; const timelineHeight = 864; const hours = Array.from({ length: 10 }, (_, index) => start + index * 60);
  const top = (minutes: number) => `${(minutes - start) * pixelsPerMinute}px`;
  const height = (from: number, to: number) => `${(to - from) * pixelsPerMinute}px`;
  return <Stack gap={12}><Row align="center" gap={8} wrap><H2>Calendar</H2><Text size="small" tone="tertiary">10:00 am to 7:00 pm</Text></Row>{DATA.suggestedFocus ? <Callout tone="info" title={`Pencilled focus block: ${DATA.suggestedFocus.startLabel} to ${DATA.suggestedFocus.endLabel}`}>{DATA.suggestedFocus.title}. {DATA.suggestedFocus.instruction}</Callout> : null}<div style={{ display: "grid", gridTemplateColumns: "74px 1fr", height: timelineHeight, border: `1px solid ${theme.stroke.secondary}`, borderRadius: 6, overflow: "hidden" }}><div style={{ position: "relative", background: theme.bg.chrome }}>{hours.map((hour) => <div key={hour} style={{ position: "absolute", top: top(hour), right: 10, transform: "translateY(-50%)" }}><Text size="small" tone="tertiary">{`${hour / 60 > 12 ? hour / 60 - 12 : hour / 60}:00 ${hour < 720 ? "am" : "pm"}`}</Text></div>)}</div><div style={{ position: "relative", background: theme.bg.elevated }}>{hours.map((hour) => <div key={hour} style={{ position: "absolute", top: top(hour), left: 0, right: 0, borderTop: `1px solid ${theme.stroke.tertiary}` }} />)}{DATA.freeBlocks.map((gap: any) => <div key={`free-${gap.start}`} style={{ position: "absolute", top: top(gap.start), height: height(gap.start, gap.end), left: 8, right: 8, padding: "4px 8px", background: theme.fill.tertiary, borderRadius: 4, overflow: "hidden" }}><Text size="small" tone="tertiary">Available: {gap.startLabel} to {gap.endLabel}</Text></div>)}{DATA.calendarBlocks.map((block: any) => <CalendarBlock key={`${block.start}-${block.title}`} block={block} start={start} pixelsPerMinute={pixelsPerMinute} />)}</div></div><Text size="small" tone="tertiary">Blue: meetings. Green: focus time. Grey: available time. Orange: highlighted meeting. Cancelled meetings do not block availability.</Text></Stack>;
}
function InitiativeCard({ initiative }: { initiative: any }) {
  const theme = useHostTheme(); const upcoming = (initiative.key_dates ?? []).filter((item: any) => !item.done && item.note !== "DONE").slice(0, 2); const statusColor = initiative.status === "critical" ? theme.category.red : initiative.status === "at-risk" ? theme.category.orange : initiative.status === "monitoring" ? theme.category.green : theme.accent.primary;
  return <Card><CardBody><Stack gap={14}><div style={{ borderLeft: `4px solid ${statusColor}`, padding: "4px 0 4px 12px", background: theme.fill.secondary, borderRadius: 4 }}><Row align="start" gap={12} wrap><Stack gap={4} style={{ flex: "1 1 280px" }}><Text size="small" weight="semibold" style={{ color: statusColor, letterSpacing: "0.04em", textTransform: "uppercase" }}>Initiative</Text><Text weight="semibold" style={{ fontSize: 19, lineHeight: "25px" }}>{initiative.name}</Text></Stack><StatusDot status={initiative.status} /></Row></div><Text size="small" tone="secondary">{initiative.phase}</Text><Grid columns="repeat(auto-fit, minmax(190px, 1fr))" gap={10}>{initiative.next_milestone ? <div style={{ padding: "10px", border: `1px solid ${theme.stroke.secondary}`, borderRadius: 6, background: theme.fill.tertiary }}><Text size="small" weight="semibold">Next milestone</Text><Text size="small">{initiative.next_milestone.what}</Text><Text size="small" tone="tertiary">{dateText(initiative.next_milestone.date)} ({initiative.next_milestone.days_out}d)</Text></div> : null}{initiative.top_blocker ? <div style={{ padding: "10px", border: `1px solid ${theme.stroke.secondary}`, borderLeft: `3px solid ${theme.category.orange}`, borderRadius: 6 }}><Text size="small" weight="semibold">Blocker</Text><Text size="small">{initiative.top_blocker}</Text></div> : null}{initiative.top_risk ? <div style={{ padding: "10px", border: `1px solid ${theme.stroke.secondary}`, borderLeft: `3px solid ${theme.category.red}`, borderRadius: 6 }}><Text size="small" weight="semibold">Risk to watch</Text><Text size="small">{initiative.top_risk}</Text></div> : null}</Grid><div style={{ padding: "10px 12px", background: theme.fill.secondary, borderRadius: 6 }}><Text size="small" weight="semibold">Next move</Text><Text size="small">{initiative.next_action}</Text></div>{upcoming.length ? <Stack gap={4}><Text size="small" tone="tertiary" weight="semibold">Upcoming dates</Text>{upcoming.map((item: any) => <div key={`${item.date}-${item.what}`}><Text size="small" tone="secondary">{dateText(item.date)} · {item.what}</Text></div>)}</Stack> : null}</Stack></CardBody></Card>;
}
function ActionCard({ action, draft, update }: { action: any; draft: Draft; update: (value: Draft) => void }) {
  const theme = useHostTheme(); const [beforeDone, setBeforeDone] = useState<ActionStatus | null>(null); const status = draft.status ?? action.status; const due = draft.due ?? action.due ?? ""; const overdue = due && new Date(`${due}T12:00:00`) < new Date(`${DATA.today}T12:00:00`); const urgent = isUrgent(due, status); const edge = overdue ? theme.category.red : urgent ? theme.category.orange : theme.accent.primary;
  return <Card style={{ overflow: "visible" }}><CardBody style={{ overflow: "visible" }}><div style={{ borderLeft: `4px solid ${edge}`, paddingLeft: 12, overflow: "visible" }}><Stack gap={10}><Row align="start" gap={12} wrap><Stack gap={6} style={{ flex: "1 1 280px" }}><Text weight="semibold" style={{ fontSize: 16, lineHeight: "22px" }}>{action.task}</Text><Row gap={8} align="center" wrap><Pill>{action.initiativeName ?? action.initiative ?? "No initiative"}</Pill><Text size="small" tone="tertiary">{action.id}</Text><Text size="small" weight="semibold" style={{ color: action.priority === "high" ? theme.category.red : theme.text.tertiary }}>{action.priority.toUpperCase()}</Text><Text size="small" weight="semibold" style={{ color: overdue ? theme.category.red : urgent ? theme.category.orange : theme.text.tertiary }}>{dueText(due, status)}</Text></Row></Stack><Checkbox checked={status === "done"} label="Mark done" onChange={(checked) => { if (checked) { if (status !== "done") setBeforeDone(status); update({ status: "done" }); } else update({ status: beforeDone ?? (action.status === "done" ? "open" : action.status) }); }} /></Row><div style={{ padding: "8px 10px", background: theme.fill.tertiary, borderRadius: 6, overflow: "visible", position: "relative", zIndex: 1 }}><Row align="center" gap={10} wrap><Text size="small" tone="tertiary" weight="semibold">Status</Text><StatusPicker value={status} onChange={(next) => update({ status: next })} /><Text size="small" tone="tertiary" weight="semibold">Due</Text><DatePicker value={due} onChange={(next) => update({ due: next })} /></Row></div><Stack gap={3}><Text size="small" tone="tertiary" weight="semibold">Notes</Text><TextInput value={draft.notes ?? action.notes ?? ""} onChange={(notes) => update({ notes })} placeholder="Optional, draft only" /></Stack></Stack></div></CardBody></Card>;
}
function StakeholderTab() {
  const stakeholder = DATA.stakeholderRaise ?? { asks: [], fyis: [], openCount: 0, askCount: 0, name: "" };
  const askRows = stakeholder.asks.map((item: any) => [item.topic, item.initiative ?? "", item.priority === "high" ? "HIGH" : item.priority === "medium" ? "Medium" : "Low", item.ask]);
  const fyiRows = stakeholder.fyis.map((item: any) => [item.topic, item.initiative ?? "", item.ask]);
  const title = stakeholder.name ? `${stakeholder.name} prep` : "Stakeholder raise";
  return <Stack gap={20}><Callout tone="info" title={title}>{stakeholder.meetingNote ?? "Raise in your regular 1:1 or initiative sync."}</Callout><Grid columns={3} gap={12}><Stat value={String(stakeholder.askCount ?? 0)} label="Decisions / asks" tone={(stakeholder.askCount ?? 0) > 0 ? "warning" : "success"} /><Stat value={String(stakeholder.fyis?.length ?? 0)} label="FYI catch-up" tone="info" /><Stat value={String(stakeholder.openCount ?? 0)} label="Open total" /></Grid><Stack gap={6}><H2>Decisions needed / asks</H2><Text size="small" tone="tertiary">Outstanding items where you need input, a decision, or alignment.</Text>{askRows.length ? <Table headers={["Topic", "Initiative", "Priority", "What to raise"]} rows={askRows} rowTone={stakeholder.asks.map((item: any) => (item.priority === "high" ? "warning" : "neutral"))} striped stickyHeader /> : <Text size="small" tone="secondary">No open asks.</Text>}</Stack>{fyiRows.length ? <Stack gap={6}><H2>FYI (catch-up, no decision needed)</H2><Table headers={["Topic", "Initiative", "Note"]} rows={fyiRows} striped stickyHeader /></Stack> : null}{stakeholder.sourceField ? <Text size="small" tone="tertiary">Canonical list: workboard.json → {stakeholder.sourceField}</Text> : null}</Stack>;
}

export default function BaWorkboard() {
  const showStakeholderTab = DATA.stakeholderRaise?.visible === true;
  const stakeholderLabel = DATA.stakeholderRaise?.name ? `${DATA.stakeholderRaise.name}` : "Stakeholder";
  const [tab, setTab] = useCanvasState<TabId>("active-tab", "today");
  const [drafts, setDrafts] = useCanvasState<Record<string, Draft>>("draft-actions", {});
  const [draftNotice, setDraftNotice] = useState("");
  const theme = useHostTheme();
  const dispatch = useCanvasAction();
  const actions = sortOpenActions(DATA.actions.filter((action: any) => action.status !== "done" && action.status !== "cancelled"));
  const activeDrafts = pruneDrafts(drafts, DATA.actions);
  const changes = countDraftChanges(drafts, DATA.actions);
  useEffect(() => {
    setDrafts((previous) => {
      const pruned = pruneDrafts(previous, DATA.actions);
      return JSON.stringify(pruned) === JSON.stringify(previous) ? previous : pruned;
    });
  }, [DATA.actionsSync]);
  const applyPrompt = `${DATA.prompts.applyPrefix}\n\n${JSON.stringify(activeDrafts, null, 2)}`;
  const saveStagedUpdates = () => {
    if (!changes) return;
    setDrafts({});
    setDraftNotice("Staged updates sent to save. Draft list cleared; cards show saved values after the canvas refreshes.");
    dispatch({ type: "newComposerChat", userPrompt: applyPrompt });
  };
  const eodPrompt = changes ? `${DATA.prompts.eod}\n\n## Staged action updates to save before closeout\nThese are deliberate workboard edits. Before the EOD critical scan, validate every ID, status, date, and note below against _workstream/${DATA.ui.actionsFile}.json. Save every valid staged update, regenerate ${DATA.ui.actionsFile}.md, report what was saved and what was rejected, then continue the full /wrap sequence.\n\n${JSON.stringify(activeDrafts, null, 2)}` : DATA.prompts.eod;
  const setTodayDone = (actionId: string, checked: boolean) => setDrafts((previous) => {
    const current = previous[actionId] ?? {};
    if (checked) return { ...previous, [actionId]: { ...current, status: "done" } };
    const { status: _status, ...remaining } = current;
    if (!Object.keys(remaining).length) {
      const { [actionId]: _removed, ...other } = previous;
      return other;
    }
    return { ...previous, [actionId]: remaining };
  });
  const focusText = [DATA.focusSummary?.mustDo ? `Must do: ${DATA.focusSummary.mustDo}` : null, ...(DATA.focusSummary?.goLiveToday ?? []).map((item: string) => `Live today: ${item}`)].filter(Boolean).join(" · ");
  return <Stack gap={0} style={{ padding: "24px 28px" }}><Row align="center" gap={12} wrap><H1>BA Workboard</H1><Spacer />{changes ? <><Button variant="primary" onClick={saveStagedUpdates}>Save staged updates ({changes})</Button><Button variant="ghost" onClick={() => { setDrafts({}); setDraftNotice("Unsaved changes discarded. Nothing was written to your action list."); }}>Discard unsaved changes</Button></> : null}<Button variant="primary" onClick={() => dispatch({ type: "newComposerChat", userPrompt: DATA.prompts.update })}>Update</Button><Button variant="secondary" onClick={() => dispatch({ type: "newComposerChat", userPrompt: eodPrompt })}>End of Day</Button></Row><Text size="small" tone="secondary">Refreshed {DATA.refreshed}</Text>{changes ? <Text size="small" tone="tertiary">{changes} staged change{changes === 1 ? "" : "s"} pending save. Save clears the draft list once sent.</Text> : null}{draftNotice ? <Text size="small" style={{ color: theme.category.green }}>{draftNotice}</Text> : null}<Text size="small" tone="tertiary" style={{ marginTop: 4 }}>Update refreshes the board. End of Day starts closeout.</Text><Row gap={8} style={{ marginTop: 20, marginBottom: 20 }}><Pill active={tab === "today"} onClick={() => setTab("today")}>Today</Pill><Pill active={tab === "initiatives"} onClick={() => setTab("initiatives")}>Initiatives</Pill><Pill active={tab === "actions"} onClick={() => setTab("actions")}>Open actions</Pill>{showStakeholderTab ? <Pill active={tab === "stakeholder"} onClick={() => setTab("stakeholder")}>{stakeholderLabel}</Pill> : null}</Row><Divider style={{ marginBottom: 20 }} />
    {tab === "today" ? <Stack gap={24}><Callout tone={DATA.focusSummary?.goLiveToday?.length ? "warning" : "info"} title="Today's focus">{focusText || "Work through the priority queue after checking the calendar."}</Callout><Divider /><CalendarTimeline /><Stack gap={8}><Row align="center" gap={8} wrap><H2>Priority order</H2><Text size="small" tone="tertiary">Ticking an item stages it as done in Open actions. Save staged updates to write to {DATA.ui.actionsFile}.json.</Text></Row><Grid columns={3} gap={12}><Stat value={String(DATA.priorityQueue.length)} label="Priority steps" tone="info" /><Stat value={String(DATA.actionSummary?.overdue ?? 0)} label="Overdue actions" tone={DATA.actionSummary?.overdue ? "danger" : "success"} /><Stat value={String(DATA.priorityQueue.filter((item: any) => item.actionId && drafts[item.actionId]?.status === "done").length)} label="Staged done" tone="success" /></Grid>{DATA.priorityQueue.map((item: any, index: number) => <div key={`${item.kind}-${item.actionId ?? item.title}`}><PriorityRow item={item} index={index} checked={item.kind === "action" ? drafts[item.actionId]?.status === "done" : false} onChange={(checked) => item.kind === "action" ? setTodayDone(item.actionId, checked) : undefined} /></div>)}</Stack>{DATA.downloads.length ? <Stack gap={4}><H2>Review and triage</H2>{DATA.downloads.slice(0, 5).map((item: string) => <div key={item}><Text size="small" tone="secondary">• {item}</Text></div>)}</Stack> : null}</Stack> : null}
    {tab === "initiatives" ? <Stack gap={16}><div style={{ background: theme.fill.secondary, border: `1px solid ${theme.stroke.secondary}`, borderRadius: 10, padding: "16px 18px" }}><Text size="small" weight="semibold" style={{ color: theme.accent.primary, letterSpacing: "0.04em", textTransform: "uppercase" }}>Portfolio view</Text><H2>Initiatives at a glance</H2><Text size="small" tone="secondary">Use this view to scan delivery health, what needs attention, and the next move. Today's must-dos stay on the Today tab.</Text></div><Grid columns={3} gap={12}><Stat value={String(DATA.initiatives.filter((initiative: any) => initiative.status !== "closed").length)} label="Active initiatives" tone="info" /><Stat value={String(DATA.atRiskCount)} label="Need attention" tone={DATA.atRiskCount ? "warning" : "success"} /><Stat value={String(DATA.initiatives.filter((initiative: any) => initiative.status === "monitoring").length)} label="Monitoring" tone="success" /></Grid><Stack gap={10}><H2>Active initiatives</H2>{DATA.initiatives.filter((initiative: any) => initiative.status !== "closed").map((initiative: any) => <div key={initiative.slug}><InitiativeCard initiative={initiative} /></div>)}</Stack>{DATA.initiatives.some((initiative: any) => initiative.status === "closed") ? <Stack gap={10}><H2>Closed initiatives</H2>{DATA.initiatives.filter((initiative: any) => initiative.status === "closed").map((initiative: any) => <div key={initiative.slug}><InitiativeCard initiative={initiative} /></div>)}</Stack> : null}</Stack> : null}
    {tab === "actions" ? <Stack gap={16} style={{ overflow: "visible" }}><Callout tone="info" title="Draft action edits">Each card is one action. Sorted by due date, then priority. Red edge = overdue; orange = due today or tomorrow. Use Save staged updates to write changes to {DATA.ui.actionsFile}.json.</Callout>{actions.map((action: any) => <div key={action.id} style={{ overflow: "visible" }}><ActionCard action={action} draft={activeDrafts[action.id] ?? {}} update={(patch) => setDrafts((old) => pruneDrafts({ ...old, [action.id]: { ...old[action.id], ...patch } }, DATA.actions))} /></div>)}</Stack> : null}
    {tab === "stakeholder" && showStakeholderTab ? <StakeholderTab /> : null}
  </Stack>;
}
