  Button, Callout, Card, CardBody, Checkbox, Divider, Grid, H1, H2, Pill, Row,
  Stat, Stack, Table, Text, useCanvasState, useHostTheme,
} from "cursor/canvas";

// Generated by render-initiative-canvas.py from status-data.json. Do not hand-edit:
// change status-data.json (or the template) and re-run the script.
type TabId = "overview" | "workstreams" | "features" | "timeline" | "dependencies" | "traceability" | "critical-path" | "tracker";
type ScopeFilter = (id: string) => boolean;
const DATA: any = /* CANVAS_DATA */;

const TABS: { id: TabId; label: string }[] = [
  { id: "overview", label: "Overview" }, { id: "workstreams", label: "Workstreams" },
  { id: "features", label: "Features & Delivery" }, { id: "timeline", label: "Timeline" },
  { id: "dependencies", label: "Dependencies" }, { id: "traceability", label: "Traceability" },
  { id: "critical-path", label: "Critical Path & Actions" }, { id: "tracker", label: "RAID & Tracker" },
];
const EMOJI: Record<string, string> = { done: "🟢", "in-progress": "🔵", pending: "○", blocked: "🔴", "at-risk": "🟡", conditional: "◐" };
const LABEL: Record<string, string> = { done: "Done", "in-progress": "In progress", pending: "Not started", blocked: "Blocked", "at-risk": "At risk", conditional: "Conditional" };
const WS_EMOJI: Record<string, string> = { complete: "🟢", active: "🔵", paused: "⏸", blocked: "🔴", "not-started": "○", na: "·" };
const WS_LABEL: Record<string, string> = { complete: "Done", active: "Active", paused: "Paused", blocked: "Blocked", "not-started": "Not started", na: "N/A" };
const MOSCOW: Record<string, string> = { Must: "🔴 Must", Should: "🟡 Should", Could: "🔵 Could", "Won't": "⚪ Won't", Wont: "⚪ Won't" };
const KIND_EMOJI: Record<string, string> = { driver: "⚖️", requirement: "📋", slice: "🍕", story: "🎟️", adr: "📌" };
const SEVERITY: Record<string, string> = { critical: "🔴 CRITICAL", high: "🔴 HIGH", medium: "🟡 MEDIUM", low: "🔵 LOW" };

function useStatusColours() {
  const theme: any = useHostTheme();
  return {
    done: theme.diff?.stripAdded ?? theme.category.green,
    "in-progress": theme.accent.primary,
    pending: theme.fill.tertiary,
    blocked: theme.diff?.stripRemoved ?? theme.category.red,
    "at-risk": theme.category.orange,
    conditional: theme.fill.secondary,
  } as Record<string, string>;
}
function tone(status: string): any {
  if (status === "done") return "success";
  if (status === "in-progress") return "info";
  if (status === "blocked") return "danger";
  if (status === "at-risk" || status === "pending") return "warning";
  return undefined;
}
function dayText(iso?: string | null) {
  if (!iso) return "";
  return new Intl.DateTimeFormat(undefined, { day: "numeric", month: "short" }).format(new Date(`${String(iso).slice(0, 10)}T12:00:00`));
}
function weeksBetween(a: string, b: string) {
  return (new Date(`${b.slice(0, 10)}T12:00:00`).getTime() - new Date(`${a.slice(0, 10)}T12:00:00`).getTime()) / (7 * 86400000);
}
function scopeLabel(id: string) {
  return DATA.scopes.find((s: any) => s.id === id)?.shortLabel ?? id;
}
function Empty({ title, children }: { title: string; children: string }) {
  return <Callout tone="info" title={title}><Text size="small">{children}</Text></Callout>;
}
function Legend() {
  const colours = useStatusColours();
  return <Row gap={12} wrap>{["done", "in-progress", "pending", "blocked"].map((k) => <Row key={k} gap={4} align="center"><span style={{ width: 11, height: 11, borderRadius: 3, background: colours[k], display: "inline-block" }} /><Text size="small" tone="secondary">{EMOJI[k]} {LABEL[k]}</Text></Row>)}</Row>;
}

// Simple layered layout: rank = longest path from a source, order within a rank by first appearance.
function layout(nodes: any[], edges: any[], nodeW: number, nodeH: number, rankGap: number, nodeGap: number) {
  const ids = new Set(nodes.map((n) => n.id));
  const live = edges.filter((e) => ids.has(e.from) && ids.has(e.to));
  const rank = new Map<string, number>(nodes.map((n) => [n.id, 0]));
  for (let pass = 0; pass < nodes.length; pass++) {
    let moved = false;
    for (const e of live) {
      const next = (rank.get(e.from) ?? 0) + 1;
      if (next > (rank.get(e.to) ?? 0) && next < nodes.length) { rank.set(e.to, next); moved = true; }
    }
    if (!moved) break;
  }
  const slots = new Map<number, number>();
  const pos = new Map<string, { x: number; y: number }>();
  nodes.forEach((n) => {
    const r = rank.get(n.id) ?? 0;
    const i = slots.get(r) ?? 0;
    slots.set(r, i + 1);
    pos.set(n.id, { x: 10 + r * (nodeW + rankGap), y: 10 + i * (nodeH + nodeGap) });
  });
  const ranks = Math.max(0, ...Array.from(rank.values())) + 1;
  const rows = Math.max(1, ...Array.from(slots.values()));
  return { pos, edges: live, width: 20 + ranks * (nodeW + rankGap), height: 20 + rows * (nodeH + nodeGap) };
}
// Everything upstream and downstream of the selected node (BFS both ways).
function chainOf(id: string | null, edges: any[]): Set<string> | null {
  if (!id) return null;
  const seen = new Set<string>([id]);
  const walk = (start: string, forward: boolean) => {
    const queue = [start];
    while (queue.length) {
      const cur = queue.shift() as string;
      for (const e of edges) {
        const next = forward ? (e.from === cur ? e.to : null) : (e.to === cur ? e.from : null);
        if (next && !seen.has(next)) { seen.add(next); queue.push(next); }
      }
    }
  };
  walk(id, true);
  walk(id, false);
  return seen;
}
function Graph({ nodes, edges, stateKey, fill, emoji }: { nodes: any[]; edges: any[]; stateKey: string; fill: (n: any) => string; emoji: (n: any) => string }) {
  const theme: any = useHostTheme();
  const [selected, setSelected] = useCanvasState<string | null>(stateKey, null);
  const g = layout(nodes, edges, 132, 44, 52, 18);
  const chain = chainOf(selected, g.edges);
  return <Stack gap={8}>
    {selected ? <div><Button variant="ghost" onClick={() => setSelected(null)}>Clear selection</Button></div> : null}
    <div style={{ overflowX: "auto" }}><svg width={g.width} height={g.height}>
      <defs><marker id={`${stateKey}-arrow`} viewBox="0 0 10 10" refX="10" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill={theme.stroke.primary} /></marker></defs>
      {g.edges.map((e: any, i: number) => {
        const a = g.pos.get(e.from)!; const b = g.pos.get(e.to)!;
        const on = chain ? chain.has(e.from) && chain.has(e.to) : true;
        return <line key={`e${i}`} x1={a.x + 132} y1={a.y + 22} x2={b.x} y2={b.y + 22} stroke={on && chain ? theme.accent.primary : theme.stroke.primary} strokeWidth={on && chain ? 2.5 : 1} opacity={on ? 0.6 : 0.15} markerEnd={`url(#${stateKey}-arrow)`} />;
      })}
      {nodes.map((n: any) => {
        const p = g.pos.get(n.id)!;
        const label = `${emoji(n)} ${n.label}`;
        return <g key={n.id} onClick={() => setSelected(selected === n.id ? null : n.id)} style={{ cursor: "pointer" }} opacity={chain && !chain.has(n.id) ? 0.2 : 1}>
          <title>{`${n.label}${n.status ? ` - ${LABEL[n.status] ?? n.status}` : ""}`}</title>
          <rect x={p.x} y={p.y} width={132} height={44} rx={6} fill={fill(n)} stroke={selected === n.id ? theme.accent.primary : theme.stroke.secondary} />
          <text x={p.x + 6} y={p.y + 26} fontSize={10} fill={theme.text.primary}>{label.length > 24 ? `${label.slice(0, 23)}…` : label}</text>
        </g>;
      })}
    </svg></div>
  </Stack>;
}

function Overview({ isActive }: { isActive: ScopeFilter }) {
  const s = DATA.stats;
  const scopes = DATA.scopes.filter((x: any) => isActive(x.id));
  const blockers = DATA.blockers.filter((b: any) => isActive(b.scope));
  const conf: Record<string, string> = { high: "🟢 High", medium: "🟡 Medium", low: "🔴 Low" };
  return <Stack gap={16}>
    <Row gap={6} wrap>{DATA.workstreams.map((w: any) => { const st = DATA.grid.initiative?.[w.id] ?? "not-started"; return <Pill key={w.id} active={st === "active"}>{WS_EMOJI[st]} {w.label}</Pill>; })}</Row>
    <Grid columns={4} gap={10}>
      <Stat value={s.deadline.value} label="Days to deadline" tone={s.deadline.tone} />
      <Stat value={s.features} label="Features on track" tone="info" />
      <Stat value={s.blockers} label="Active blockers" tone={s.blockers === "0" ? "success" : "warning"} />
      <Stat value={s.decisions} label="Decisions confirmed" tone="info" />
    </Grid>
    <Callout tone="info" title="Where we are right now"><Text size="small">{DATA.narrative || "No narrative in status-data.json yet."}</Text></Callout>
    <H2>Top blockers</H2>
    {blockers.length ? <Grid columns={2} gap={10}>{blockers.slice(0, 4).map((b: any) => <Callout key={b.id + b.title} tone="danger" title={`🔴 ${b.title}`}><Text size="small">{[b.impact, b.owner ? `owner ${b.owner}` : "", b.daysOverdue ? `${b.daysOverdue}d overdue` : ""].filter(Boolean).join(" · ")}</Text></Callout>)}</Grid> : <Text size="small" tone="secondary">No active blockers recorded.</Text>}
    <H2>Where each scope is right now</H2>
    <Table headers={["Scope", "In workstream(s)", "Status"]} rows={scopes.map((x: any) => {
      const active = DATA.workstreams.filter((w: any) => DATA.grid[x.id]?.[w.id] === "active").map((w: any) => w.label).join(" + ") || "-";
      const f = DATA.features.find((ft: any) => ft.id === x.id);
      return [x.label, active, f ? `${EMOJI[f.status]} ${LABEL[f.status]}` : ""];
    })} />
    <H2>Confidence</H2>
    {DATA.confidence.length ? <Table headers={["Area", "Score", "Note"]} rows={DATA.confidence.map((c: any) => [c.area, conf[c.score] ?? `○ ${c.score}`, c.note])} rowTone={DATA.confidence.map((c: any) => c.score === "high" ? "success" : c.score === "medium" ? "warning" : c.score === "low" ? "danger" : undefined)} /> : <Empty title="No confidence scores yet">Add confidenceScores to status-data.json.</Empty>}
  </Stack>;
}

function Workstreams({ isActive }: { isActive: ScopeFilter }) {
  const theme: any = useHostTheme();
  const colours = useStatusColours();
  const rows = DATA.scopes.filter((x: any) => isActive(x.id));
  const cellW = 102, cellH = 32, labelW = 220, headerH = 38, gap = 2;
  const width = labelW + DATA.workstreams.length * (cellW + gap) + 20;
  const height = headerH + rows.length * (cellH + gap) + 20;
  const fill = (st: string) => st === "complete" ? colours.done : st === "active" ? colours["in-progress"] : st === "paused" || st === "blocked" ? colours.blocked : st === "na" ? "transparent" : colours.pending;
  const firstFeature = rows.findIndex((r: any) => r.level === "feature");
  const firstCohort = rows.findIndex((r: any) => r.level === "cohort");
  return <Stack gap={12}>
    {DATA.scopes.length === 1 ? <Empty title="Only the initiative row so far">Sub-scope workstreams will populate once features and cohorts are defined in Discovery.</Empty> : null}
    <div style={{ overflowX: "auto" }}><svg width={width} height={height}>
      {DATA.workstreams.map((w: any, i: number) => <text key={w.id} x={labelW + i * (cellW + gap) + cellW / 2} y={headerH - 12} textAnchor="middle" fontSize={11} fontWeight="600" fill={theme.text.primary}>{w.label}</text>)}
      {rows.map((r: any, ri: number) => {
        const y = headerH + ri * (cellH + gap);
        const cohort = r.level === "cohort";
        return <g key={r.id}>
          {ri % 2 === 0 ? <rect x={0} y={y} width={labelW} height={cellH} fill={theme.fill.tertiary} opacity={0.15} /> : null}
          {ri === firstFeature || ri === firstCohort ? <line x1={0} x2={width} y1={y - 1} y2={y - 1} stroke={theme.stroke.secondary} strokeWidth={1} /> : null}
          <text x={cohort ? 16 : 4} y={y + cellH / 2 + 4} fontSize={11} fontWeight={cohort ? "500" : "700"} fill={theme.text.primary}>{cohort ? `↳ ${r.shortLabel}` : r.shortLabel}</text>
          {DATA.workstreams.map((w: any, i: number) => {
            const st = DATA.grid[r.id]?.[w.id] ?? "not-started";
            const x = labelW + i * (cellW + gap);
            return <g key={w.id}><title>{`${r.label} - ${w.label}: ${WS_LABEL[st]}`}</title>
              <rect x={x} y={y} width={cellW} height={cellH} rx={4} fill={fill(st)} opacity={st === "na" ? 0.08 : 0.8} />
              {st !== "na" ? <text x={x + cellW / 2} y={y + cellH / 2 + 4} textAnchor="middle" fontSize={10} fontWeight={st === "active" ? "700" : "500"} fill={theme.text.primary}>{`${WS_EMOJI[st]} ${WS_LABEL[st]}`}</text> : null}
            </g>;
          })}
        </g>;
      })}
    </svg></div>
    <Text size="small" tone="secondary">🟢 Done · 🔵 Active · ⏸ Paused · 🔴 Blocked · ○ Not started · · N/A</Text>
    <H2>Recent workstream changes</H2>
    {DATA.changes.length ? <Table headers={["Date", "Scope", "Workstream", "Change"]} rows={DATA.changes.filter((c: any) => isActive(c.scope)).map((c: any) => [c.date, scopeLabel(c.scope), c.workstream, c.change])} /> : <Text size="small" tone="secondary">No workstream changes logged (optional workstreamChanges in status-data.json).</Text>}
  </Stack>;
}

function Features({ isActive }: { isActive: ScopeFilter }) {
  const features = DATA.features.filter((f: any) => isActive(f.id));
  const stories = DATA.stories.filter((s: any) => isActive(s.scope));
  const cols = DATA.moscow.columns.filter((c: string) => isActive(c));
  return <Stack gap={14}>
    <Text size="small" tone="secondary">Features in flight, with the workstreams each is in right now.</Text>
    {features.length ? <Table headers={["Feature", "Active workstream(s)", "Owner", "Health", "Priority cover"]} rows={features.map((f: any) => [f.name, f.workstreams.join(" + ") || "-", f.owner, `${EMOJI[f.status]} ${LABEL[f.status]}`, f.cover])} rowTone={features.map((f: any) => tone(f.status))} /> : <Empty title="No features yet">Add features (or scopes with level feature) to status-data.json.</Empty>}
    <H2>Stories in flight</H2>
    {stories.length ? <Table headers={["Title", "Scope", "Priority", "Status", "Key"]} rows={stories.map((s: any) => [s.title, scopeLabel(s.scope), s.moscow ? MOSCOW[s.moscow] ?? s.moscow : "⚠ unrated", `${EMOJI[s.status]} ${s.statusText}`, s.key])} rowTone={stories.map((s: any) => s.moscow ? tone(s.status) : "danger")} striped stickyHeader /> : <Text size="small" tone="secondary">No stories for this scope.</Text>}
    <H2>MoSCoW priority matrix</H2>
    {DATA.moscow.rows.length && cols.length ? <Table headers={["Requirement", ...cols.map(scopeLabel)]} rows={DATA.moscow.rows.map((r: any) => [`${r.id} ${r.text}`, ...cols.map((c: string) => MOSCOW[r.cells[c]] ?? "⚠ unrated")])} /> : <Text size="small" tone="secondary">No MoSCoW ratings for this scope yet.</Text>}
  </Stack>;
}

function Timeline({ isActive }: { isActive: ScopeFilter }) {
  const theme: any = useHostTheme();
  const colours = useStatusColours();
  const tl = DATA.timeline;
  const lanes = tl.lanes.filter((l: any) => l.scopes.some(isActive));
  const bars = tl.bars.filter((b: any) => isActive(b.scope) && lanes.some((l: any) => l.id === b.lane));
  const milestones = tl.milestones.filter((m: any) => isActive(m.scope));
  if (!milestones.length && !bars.length) return <Empty title="No dated work yet">Add milestones with target dates (or timeline.bars) to status-data.json, then run /canvas.</Empty>;
  const colWidth = 92, rowHeight = 34, labelWidth = 160, headerHeight = 36, milestoneLaneH = 56;
  const milestoneLaneTop = headerHeight + 8, lanesStart = milestoneLaneTop + milestoneLaneH + 4;
  const x = (iso: string) => labelWidth + weeksBetween(tl.start, iso) * colWidth;
  const rowOf = new Map<string, number>();
  const subRows = new Map<string, number>();
  lanes.forEach((lane: any) => {
    const rows: any[][] = [];
    [...bars.filter((b: any) => b.lane === lane.id)].sort((a: any, b: any) => a.start.localeCompare(b.start)).forEach((bar: any) => {
      const i = rows.findIndex((r) => r[r.length - 1].end <= bar.start);
      if (i >= 0) { rows[i].push(bar); rowOf.set(bar.id, i); } else { rows.push([bar]); rowOf.set(bar.id, rows.length - 1); }
    });
    subRows.set(lane.id, Math.max(rows.length, 1));
  });
  const laneTop = new Map<string, number>();
  let y = lanesStart;
  lanes.forEach((lane: any) => { laneTop.set(lane.id, y); y += (subRows.get(lane.id) ?? 1) * rowHeight + 12; });
  const width = labelWidth + tl.weeks * colWidth + 20, height = y + 20;
  const weeks = Array.from({ length: tl.weeks }, (_, i) => i);
  const startDate = new Date(`${tl.start}T12:00:00`);
  return <Stack gap={10}>
    <div style={{ overflowX: "auto" }}><svg width={width} height={height}>
      {weeks.map((w) => { const d = new Date(startDate.getTime() + w * 7 * 86400000); const gx = labelWidth + w * colWidth; return <g key={w}>
        <line x1={gx} x2={gx} y1={milestoneLaneTop} y2={height - 10} stroke={theme.stroke.tertiary} strokeDasharray="2 4" />
        <text x={gx + 4} y={14} fontSize={10} fontWeight="700" fill={theme.text.primary}>{dayText(d.toISOString())}</text>
        <text x={gx + 4} y={28} fontSize={9} fill={theme.text.tertiary}>{`wk ${w + 1}`}</text></g>; })}
      <rect x={0} y={milestoneLaneTop} width={width} height={milestoneLaneH} fill={theme.fill.tertiary} opacity={0.18} />
      <text x={6} y={milestoneLaneTop + 18} fontSize={11} fontWeight="600" fill={theme.text.primary}>📅 Milestones</text>
      {milestones.map((m: any) => <g key={m.id}><title>{`${m.label} - ${dayText(m.date)}`}</title>
        <text x={x(m.date)} y={milestoneLaneTop + 18} textAnchor="middle" fontSize={16}>{m.emoji}</text>
        <text x={x(m.date)} y={milestoneLaneTop + 34} textAnchor="middle" fontSize={9} fontWeight="600" fill={theme.text.primary}>{m.label.length > 22 ? `${m.label.slice(0, 21)}…` : m.label}</text>
        <text x={x(m.date)} y={milestoneLaneTop + 46} textAnchor="middle" fontSize={9} fill={theme.text.tertiary}>{dayText(m.date)}</text></g>)}
      {lanes.map((lane: any, li: number) => { const top = laneTop.get(lane.id) ?? 0; const h = (subRows.get(lane.id) ?? 1) * rowHeight + 12; return <g key={lane.id}>
        {li % 2 === 0 ? <rect x={0} y={top} width={width} height={h} fill={theme.fill.tertiary} opacity={0.25} /> : null}
        <text x={6} y={top + 20} fontSize={11} fontWeight="600" fill={theme.text.primary}>{lane.label}</text></g>; })}
      {bars.map((bar: any) => { const bx = x(bar.start) + 2; const by = (laneTop.get(bar.lane) ?? 0) + 6 + (rowOf.get(bar.id) ?? 0) * rowHeight; const bw = Math.max(weeksBetween(bar.start, bar.end) * colWidth - 4, 24); const label = `${EMOJI[bar.status]} ${bar.label}${bar.forecast ? " (forecast)" : ""}`; return <g key={bar.id}>
        <title>{`${bar.label} - ${LABEL[bar.status]} - scope: ${scopeLabel(bar.scope)}`}</title>
        <rect x={bx} y={by} width={bw} height={rowHeight - 8} rx={4} fill={colours[bar.status]} opacity={0.88} stroke={bar.forecast ? theme.stroke.primary : "none"} strokeDasharray={bar.forecast ? "4 2" : undefined} />
        <text x={bx + 6} y={by + (rowHeight - 8) / 2} dominantBaseline="middle" fontSize={10} fontWeight="500" fill={theme.text.primary}>{label.length > bw / 6.5 ? `${label.slice(0, Math.max(3, Math.floor(bw / 6.5) - 1))}…` : label}</text></g>; })}
      <line x1={x(DATA.today)} x2={x(DATA.today)} y1={headerHeight} y2={height - 10} stroke={theme.accent.primary} strokeWidth={2} strokeDasharray="4 4" />
      <text x={x(DATA.today) + 4} y={headerHeight + 2} fontSize={10} fontWeight="700" fill={theme.accent.primary}>Today</text>
      {tl.deadline ? <g><line x1={x(tl.deadline)} x2={x(tl.deadline)} y1={headerHeight} y2={height - 10} stroke={colours.blocked} strokeWidth={2} strokeDasharray="6 3" />
        <text x={x(tl.deadline) + 4} y={height - 14} fontSize={10} fontWeight="700" fill={colours.blocked}>{`⛔ ${dayText(tl.deadline)}`}</text></g> : null}
    </svg></div>
    <Legend />
    <Text size="small" tone="tertiary">Bar length = duration in weeks × column width. Bars auto-pack into sub-rows so they never overlap.</Text>
  </Stack>;
}

function Dependencies({ isActive }: { isActive: ScopeFilter }) {
  const colours = useStatusColours();
  const dep = DATA.dependencies;
  const nodes = dep.nodes.filter((n: any) => isActive(n.scope) || n.id === dep.final);
  const blockers = DATA.blockers.filter((b: any) => isActive(b.scope)).slice(0, 3);
  return <Stack gap={12}>
    {blockers.map((b: any) => <Callout key={b.id + b.title} tone="danger" title={`🔴 ${b.title}`}><Text size="small">{b.impact}</Text></Callout>)}
    {nodes.length ? <Graph nodes={nodes} edges={dep.edges} stateKey="dep-selected" fill={(n) => colours[n.status] ?? colours.pending} emoji={(n) => EMOJI[n.status] ?? "○"} /> : <Empty title="No dependency data yet">Add raid.dependencies with a blocks field, or a dependencyGraph block, to status-data.json.</Empty>}
    <Text size="small" tone="tertiary">Click a node to highlight everything upstream and downstream of it.</Text>
    <Legend />
  </Stack>;
}

function Traceability({ isActive }: { isActive: ScopeFilter }) {
  const theme: any = useHostTheme();
  const tr = DATA.traceability;
  const [selected] = useCanvasState<string | null>("trace-selected", null);
  const nodes = tr.nodes.filter((n: any) => n.kind === "driver" || isActive(n.scope ?? "initiative"));
  const kindFill: Record<string, string> = { driver: theme.diff?.stripRemoved ?? theme.category.red, requirement: theme.accent.primary, slice: theme.fill.secondary, story: theme.fill.tertiary, adr: theme.diff?.stripAdded ?? theme.category.green };
  const rows = tr.rows.filter((r: any) => isActive(r.scope));
  return <Stack gap={12}>
    <Text size="small" tone="secondary">⚖️ Driver · 📋 Requirement · 🍕 Slice · 🎟️ Story · 📌 ADR</Text>
    {nodes.length ? <Graph nodes={nodes} edges={tr.edges} stateKey="trace-selected" fill={(n) => kindFill[n.kind]} emoji={(n) => KIND_EMOJI[n.kind] ?? ""} /> : null}
    {rows.length ? <Table headers={["Driver", "Requirement", "Slice", "Stories", "ADRs"]} rows={rows.map((r: any) => [r.driver, `${r.warn ? "⚠ " : ""}${r.requirement}`, r.slice, r.stories, r.adrs])} rowTone={rows.map((r: any) => r.nodeId && r.nodeId === selected ? "info" : r.warn ? "warning" : undefined)} /> : <Empty title="No traceability yet">Link stories to requirements (stories[].linkedRequirements) in status-data.json.</Empty>}
  </Stack>;
}

function CriticalPath({ isActive }: { isActive: ScopeFilter }) {
  const cp = DATA.criticalPath.filter((c: any) => isActive(c.scope));
  const actions = DATA.actionsThisWeek.filter((a: any) => isActive(a.scope));
  const unrated = DATA.stories.filter((s: any) => isActive(s.scope) && !s.moscow);
  return <Stack gap={14}>
    <H2>Critical path to deadline</H2>
    {cp.length ? <Table headers={["#", "Milestone", "Date", "Status", "Owner"]} rows={cp.map((c: any) => [c.id, c.milestone, c.date, `${EMOJI[c.status]} ${LABEL[c.status]}`, c.owner])} rowTone={cp.map((c: any) => tone(c.status))} /> : <Empty title="No critical path yet">Add criticalPath or milestones to status-data.json.</Empty>}
    <H2>Actions due this week</H2>
    {actions.length ? <Table headers={["Action", "Owner", "Due", "Status"]} rows={actions.map((a: any) => [a.text, a.owner, dayText(a.due), a.status])} /> : <Text size="small" tone="secondary">No actions due this week.</Text>}
    {unrated.length ? <Callout tone="warning" title={`⚠ ${unrated.length} stories have no MoSCoW rating`}><Text size="small">{unrated.map((s: any) => s.key || s.title).join(", ")}</Text></Callout> : null}
  </Stack>;
}

function RaidCard({ id, title, rows, headers, cells, defaultOpen, outstandingOnly }: { id: string; title: string; rows: any[]; headers: string[]; cells: (r: any) => string[]; defaultOpen: boolean; outstandingOnly: boolean }) {
  const [open, setOpen] = useCanvasState<boolean>(`raid-open-${id}`, defaultOpen);
  const shown = outstandingOnly ? rows.filter((r) => r.outstanding) : rows;
  const outstanding = rows.filter((r) => r.outstanding).length;
  return <Card><CardBody><Stack gap={8}>
    <Row align="center" gap={8}><Button variant="ghost" onClick={() => setOpen(!open)}>{open ? "▾" : "▸"} {`${title} (${rows.length} total · ${outstanding} outstanding)`}</Button></Row>
    {open ? (shown.length ? <Table headers={[...headers, "ID"]} rows={shown.map((r) => [...cells(r), r.id])} rowTone={shown.map((r) => tone(r.outstanding ? (String(r.status).toLowerCase() === "blocked" ? "blocked" : "") : "done"))} /> : <Text size="small" tone="secondary">Nothing outstanding here.</Text>) : null}
  </Stack></CardBody></Card>;
}

function Tracker({ isActive, showingInitiative, description }: { isActive: ScopeFilter; showingInitiative: boolean; description: string }) {
  const [outstandingOnly, setOutstandingOnly] = useCanvasState<boolean>("outstandingOnly", true);
  const r = DATA.raid;
  const f = (rows: any[]) => rows.filter((x) => isActive(x.scope));
  return <Stack gap={10}>
    <Row align="center" gap={12} wrap><H2>RAID & Tracker</H2><div style={{ flex: 1 }} /><Checkbox checked={outstandingOnly} label="Show outstanding items only" onChange={(v: boolean) => setOutstandingOnly(v)} /></Row>
    {!showingInitiative ? <Text size="small" tone="secondary">{`Showing tracker items for: ${description}`}</Text> : null}
    <RaidCard id="decisions" title="📌 Decisions" rows={f(r.decisions)} headers={["Decision", "Made by", "Status"]} cells={(x) => [x.text, x.owner, x.status]} defaultOpen={true} outstandingOnly={outstandingOnly} />
    <RaidCard id="risks" title="🧨 Risks" rows={f(r.risks)} headers={["Risk", "Owner", "Severity"]} cells={(x) => [x.text, x.owner, SEVERITY[x.severity] ?? x.severity]} defaultOpen={true} outstandingOnly={outstandingOnly} />
    <RaidCard id="questions" title="❓ Open questions" rows={f(r.questions)} headers={["Question", "Owner", "Status"]} cells={(x) => [x.text, x.owner, x.status]} defaultOpen={false} outstandingOnly={outstandingOnly} />
    <RaidCard id="assumptions" title="⚠️ Assumptions" rows={f(r.assumptions)} headers={["Assumption", "Owner", "Confidence"]} cells={(x) => [x.text, x.owner, x.confidence]} defaultOpen={false} outstandingOnly={outstandingOnly} />
    <RaidCard id="actions" title="🎯 Actions" rows={f(r.actions)} headers={["Action", "Owner", "Status"]} cells={(x) => [x.text, x.owner, x.status]} defaultOpen={true} outstandingOnly={outstandingOnly} />
  </Stack>;
}

export default function InitiativeStatusCanvas() {
  const theme: any = useHostTheme();
  const [section, setSection] = useCanvasState<TabId>("section", "overview");
  const [selectedScopes, setSelectedScopes] = useCanvasState<string[]>("selectedScopes", ["initiative"]);
  const toggleScope = (id: string) => {
    if (id === "initiative") { setSelectedScopes(["initiative"]); return; }
    const was = selectedScopes.includes(id);
    let next = selectedScopes.filter((s) => s !== "initiative");
    next = was ? next.filter((s) => s !== id) : [...next, id];
    if (next.length === 0) next = ["initiative"];
    setSelectedScopes(next);
  };
  const showingInitiative = selectedScopes.length === 1 && selectedScopes[0] === "initiative";
  const isScopeActive: ScopeFilter = (id) => showingInitiative || selectedScopes.includes(id);
  const description = showingInitiative ? "Showing the whole initiative (Initiative level)" : `Showing: ${DATA.scopes.filter((s: any) => selectedScopes.includes(s.id)).map((s: any) => s.shortLabel).join(", ")}`;
  const ini = DATA.initiative;
  const people = [["Sponsor", ini.sponsor], ["PM", ini.pm], ["Tech lead", ini.techLead], ["BA", ini.ba]].filter((p) => p[1]).map((p) => `${p[0]}: ${p[1]}`).join(" · ");
  const groups = ["initiative", "feature", "cohort"].map((level) => DATA.scopes.filter((s: any) => s.level === level)).filter((g: any[]) => g.length);
  return <Stack gap={0} style={{ padding: "24px 28px" }}>
    {DATA.approval.show ? <div style={{ position: "sticky", top: 0, zIndex: 10, marginBottom: 12 }}><Callout tone="warning" title={`⚠️ DRAFT - pending approval from ${DATA.approval.approver}`}><Text size="small">Problem statement, success metrics, scope, and RAID are draft v1 outputs. Do not treat as authoritative until PM sign-off is captured.</Text></Callout></div> : null}
    <H1>{ini.name}</H1>
    <Text size="small" tone="secondary">{[ini.phase, `Status as at ${dayText(DATA.today)}`, people].filter(Boolean).join(" · ")}</Text>
    <Row gap={6} wrap align="center" style={{ marginTop: 16 }}>
      <Text size="small" tone="secondary">Filter scope:</Text>
      {groups.map((group: any[], gi: number) => <Row key={gi} gap={6} wrap align="center">
        {gi > 0 ? <Text size="small" tone="tertiary">|</Text> : null}
        {group.map((s: any) => { const on = selectedScopes.includes(s.id); return <Pill key={s.id} active={on} onClick={() => toggleScope(s.id)}>{`${on ? "✓ " : ""}${s.level === "initiative" ? "🏛️ " : ""}${s.label}`}</Pill>; })}
      </Row>)}
    </Row>
    <Text size="small" tone="secondary">{`${description} · click a feature or cohort to drill in · click "Initiative level" to reset`}</Text>
    <Row gap={8} wrap style={{ marginTop: 16, marginBottom: 16 }}>{TABS.map((t) => <Pill key={t.id} active={section === t.id} onClick={() => setSection(t.id)}>{t.label}</Pill>)}</Row>
    <Divider style={{ marginBottom: 16 }} />
    {section === "overview" ? <Overview isActive={isScopeActive} /> : null}
    {section === "workstreams" ? <Workstreams isActive={isScopeActive} /> : null}
    {section === "features" ? <Features isActive={isScopeActive} /> : null}
    {section === "timeline" ? <Timeline isActive={isScopeActive} /> : null}
    {section === "dependencies" ? <Dependencies isActive={isScopeActive} /> : null}
    {section === "traceability" ? <Traceability isActive={isScopeActive} /> : null}
    {section === "critical-path" ? <CriticalPath isActive={isScopeActive} /> : null}
    {section === "tracker" ? <Tracker isActive={isScopeActive} showingInitiative={showingInitiative} description={description} /> : null}
    <Text size="small" tone="tertiary" style={{ marginTop: 24, color: theme.text.tertiary }}>{`Generated ${DATA.generated} from ${DATA.source}. Re-run /canvas to refresh; do not edit this file by hand.`}</Text>
  </Stack>;
}
